# Copy this file to .env and fill in real values

# =========================
# SWS (Smart Web Service)
# =========================

# Base URL for SWS SOAP endpoint
SWS_BASE_URL=https://smart.eltratec.com/SmartWebDev/SmartWebService.asmx

# Username for SWS login (used for testing or system access)
SWS_USERNAME=your_username_here

# Password for SWS login
SWS_PASSWORD=your_password_here

# Request timeout in milliseconds
SWS_TIMEOUT_MILLIS=10000


# =========================
# GM (Eltratec Gateway)
# =========================

# Port where GM service runs
GM_PORT=8081

GM_API_AUTH_TOKEN=change-this-dev-token