# ===========================
# Sensum Environment Example
# Copy this file to .env and fill in your local values.
# Do not put real production credentials here.
# ===========================


# ===========================
# SWS / Eltratec SOAP service
# ===========================

SWS_BASE_URL=
SWS_TIMEOUT_MILLIS=


# ===========================
# GM Middleware
# ===========================

GM_PORT=
GM_HOST=
GM_API_AUTH_TOKEN=
GM_AUTH_TOKEN_TTL_HOURS=


# ===========================
# PostgreSQL
# ===========================

POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=


# ===========================
# Backend Core
# ===========================

BACKEND_CORE_PORT=
BACKEND_CORE_HOST=
BACKEND_CORE_DB_JDBC_URL=
BACKEND_CORE_DB_USER=
BACKEND_CORE_DB_PASSWORD=


# ===========================
# API Gateway
# ===========================

API_GATEWAY_PORT=
API_GATEWAY_HOST=
GM_BASE_URL=


# ===========================
# Grafana
# ===========================

GRAFANA_PORT=
GF_SECURITY_ALLOW_EMBEDDING=
GF_AUTH_ANONYMOUS_ENABLED=
GF_AUTH_ANONYMOUS_ORG_ROLE=


# ===========================
# Frontend / Next.js
# ===========================

FRONTEND_PORT=
NEXT_PUBLIC_API_URL=