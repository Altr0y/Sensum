# ===========================
# Sensum Environment Example
# Copy this file to .env and fill in your local values.
# Do not put real production credentials here.
# ===========================


# ===========================
# SWS / Eltratec SOAP service
# ===========================

SWS_BASE_URL=
SWS_TIMEOUT_MILLIS=


# ===========================
# GM Middleware
# ===========================

GM_PORT=
GM_HOST=
GM_AUTH_TOKEN_TTL_HOURS=

GM_SERVICE_JWT_SECRET=
GM_SERVICE_JWT_ISSUER=
GM_SERVICE_JWT_AUDIENCE=
GM_SERVICE_JWT_REALM=


# ===========================
# PostgreSQL
# ===========================

POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=


# ===========================
# Backend Core
# ===========================

BACKEND_CORE_PORT=
BACKEND_CORE_HOST=
BACKEND_CORE_DB_JDBC_URL=
BACKEND_CORE_DB_USER=
BACKEND_CORE_DB_PASSWORD=

GM_BASE_URL=
GM_SERVICE_JWT_TTL_SECONDS=


# ===========================
# API Gateway
# ===========================

API_GATEWAY_PORT=
API_GATEWAY_HOST=
BACKEND_CORE_BASE_URL=

API_AUTH_USERNAME=
API_AUTH_PASSWORD=

JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_REALM=
JWT_TTL_SECONDS=


# ===========================
# Grafana
# ===========================

GRAFANA_PORT=
GF_SECURITY_ALLOW_EMBEDDING=
GF_AUTH_ANONYMOUS_ENABLED=
GF_AUTH_ANONYMOUS_ORG_ROLE=


# ===========================
# Frontend / Next.js
# ===========================

FRONTEND_PORT=
NEXT_PUBLIC_API_URL=