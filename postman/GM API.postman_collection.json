        {
          "name": "Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "\r",
                  "if (json.token) {\r",
                  "    pm.environment.set(\"gmSessionToken\", json.token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "function base64Url(source) {\r",
                  "    return CryptoJS.enc.Base64.stringify(source)\r",
                  "        .replace(/=+$/, \"\")\r",
                  "        .replace(/\\+/g, \"-\")\r",
                  "        .replace(/\\//g, \"_\");\r",
                  "}\r",
                  "\r",
                  "const secret = pm.environment.get(\"gmServiceJwtSecret\");\r",
                  "const issuer = pm.environment.get(\"gmServiceJwtIssuer\");\r",
                  "const audience = pm.environment.get(\"gmServiceJwtAudience\");\r",
                  "\r",
                  "if (!secret) {\r",
                  "    throw new Error(\"Missing gmServiceJwtSecret in Postman environment.\");\r",
                  "}\r",
                  "\r",
                  "if (!issuer) {\r",
                  "    throw new Error(\"Missing gmServiceJwtIssuer in Postman environment.\");\r",
                  "}\r",
                  "\r",
                  "if (!audience) {\r",
                  "    throw new Error(\"Missing gmServiceJwtAudience in Postman environment.\");\r",
                  "}\r",
                  "\r",
                  "const now = Math.floor(Date.now() / 1000);\r",
                  "\r",
                  "const header = {\r",
                  "    alg: \"HS256\",\r",
                  "    typ: \"JWT\"\r",
                  "};\r",
                  "\r",
                  "const payload = {\r",
                  "    iss: issuer,\r",
                  "    aud: audience,\r",
                  "    sub: \"backend-core\",\r",
                  "    username: \"backend-core\",\r",
                  "    role: \"SERVICE\",\r",
                  "    service: \"backend-core\",\r",
                  "    iat: now,\r",
                  "    exp: now + 3600\r",
                  "};\r",
                  "\r",
                  "const encodedHeader = base64Url(\r",
                  "    CryptoJS.enc.Utf8.parse(JSON.stringify(header))\r",
                  ");\r",
                  "\r",
                  "const encodedPayload = base64Url(\r",
                  "    CryptoJS.enc.Utf8.parse(JSON.stringify(payload))\r",
                  ");\r",
                  "\r",
                  "const signature = base64Url(\r",
                  "    CryptoJS.HmacSHA256(`${encodedHeader}.${encodedPayload}`, secret)\r",
                  ");\r",
                  "\r",
                  "const token = `${encodedHeader}.${encodedPayload}.${signature}`;\r",
                  "\r",
                  "pm.environment.set(\"gmServiceToken\", token);\r",
                  "\r",
                  "console.log(\"Generated gmServiceToken:\", token);\r",
                  "console.log(\"JWT issuer:\", issuer);\r",
                  "console.log(\"JWT audience:\", audience);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{gmServiceToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
