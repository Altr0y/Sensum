  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const setCookieHeader = pm.response.headers.get(\"Set-Cookie\");\r",
              "\r",
              "if (!setCookieHeader) {\r",
              "    throw new Error(\"Login response does not contain Set-Cookie header.\");\r",
              "}\r",
              "\r",
              "const swsCookie = setCookieHeader.split(\";\")[0];\r",
              "\r",
              "pm.environment.set(\"swsCookie\", swsCookie);\r",
              "\r",
              "console.log(\"Saved swsCookie:\", swsCookie);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8",
            "type": "text"
          },
          {
            "key": "SOAPAction",
            "value": "\"http://www.eltratec.com/Login\"",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<soap:Envelope \r\n    xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \r\n    xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" \r\n    xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\r\n  <soap:Body>\r\n    <Login xmlns=\"http://www.eltratec.com/\">\r\n      <UserName>{{swsUsername}}</UserName>\r\n      <Password>{{swsPassword}}</Password>\r\n    </Login>\r\n  </soap:Body>\r\n</soap:Envelope>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "https://smart.eltratec.com/SmartWebDev/SmartWebService.asmx",
          "protocol": "https",
          "host": [
            "smart",
            "eltratec",
            "com"
          ],
          "path": [
            "SmartWebDev",
            "SmartWebService.asmx"
          ]
        }
      },
      "response": []
    },
