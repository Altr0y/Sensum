{
  "id": null,
  "uid": "sensum-measurements",
  "title": "Meritve",
  "tags": ["sensum"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 6,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Meritve skozi čas",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
      "description": "Združen prikaz vrednosti vseh kanalov v izbranem časovnem obsegu.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
          "urlPath": "/measurements/range",
          "method": "GET",
          "queryParams": "from=${__from:date:iso}&to=${__to:date:iso}",
          "fields": [
            { "jsonPath": "$.series[*].points[*].dateTime", "name": "Time", "type": "time" },
            { "jsonPath": "$.series[*].points[*].value", "name": "Vrednost", "type": "number" }
          ],
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Povprečna vrednost",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
          "urlPath": "/measurements/range",
          "method": "GET",
          "queryParams": "from=${__from:date:iso}&to=${__to:date:iso}",
          "fields": [
            { "jsonPath": "$.average", "name": "Povprečje", "type": "number" }
          ],
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Min vrednost",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
          "urlPath": "/measurements/range",
          "method": "GET",
          "queryParams": "from=${__from:date:iso}&to=${__to:date:iso}",
          "fields": [
            { "jsonPath": "$.minimum", "name": "Min", "type": "number" }
          ],
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Max vrednost",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "orange", "value": null }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
          "urlPath": "/measurements/range",
          "method": "GET",
          "queryParams": "from=${__from:date:iso}&to=${__to:date:iso}",
          "fields": [
            { "jsonPath": "$.maximum", "name": "Max", "type": "number" }
          ],
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Meritve",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
      "options": {
        "sortBy": [{ "displayName": "Time", "desc": true }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "false": { "text": "ALARM", "color": "red" }, "true": { "text": "OK", "color": "green" } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
          "urlPath": "/measurements/range",
          "method": "GET",
          "queryParams": "from=${__from:date:iso}&to=${__to:date:iso}",
          "fields": [
            { "jsonPath": "$.table[*].dateTime", "name": "Time", "type": "time" },
            { "jsonPath": "$.table[*].station", "name": "Postaja", "type": "string" },
            { "jsonPath": "$.table[*].serialNumber", "name": "Serijska št.", "type": "string" },
            { "jsonPath": "$.table[*].channel", "name": "Kanal", "type": "string" },
            { "jsonPath": "$.table[*].unit", "name": "Enota", "type": "string" },
            { "jsonPath": "$.table[*].value", "name": "Vrednost", "type": "number" },
            { "jsonPath": "$.table[*].status", "name": "Status", "type": "boolean" },
            { "jsonPath": "$.table[*].source", "name": "Vir", "type": "string" }
          ],
          "refId": "A"
        }
      ]
    }
  ]
}
