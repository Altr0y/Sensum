      "targets": [
        {
          "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
          "urlPath": "/overview",
          "method": "GET",
          "fields": [
            { "jsonPath": "$.channelCount", "name": "Kanali", "type": "number" }
