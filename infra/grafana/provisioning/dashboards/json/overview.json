        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "orange", "value": null }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
          "urlPath": "/overview",
          "method": "GET",
          "fields": [
            { "jsonPath": "$.measurementCount", "name": "Meritve", "type": "number" }
