{
  "id": null,
  "uid": "sensum-overview",
  "title": "Overview",
  "tags": ["sensum"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Postaje",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "marcusolsson-json-datasource", "uid": "sensum-stats-api" },
          "urlPath": "/overview",
          "method": "GET",
          "fields": [
            { "jsonPath": "$.stationCount", "name": "Postaje", "type": "number" }
          ],
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
